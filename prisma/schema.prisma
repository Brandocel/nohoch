generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── Hero ─────────────────────────────────────────────────────────────────────

model HeroSlide {
  id           String                 @id @default(cuid())
  order        Int                    @default(0)
  isActive     Boolean                @default(true)
  mediaType    MediaType              @default(IMAGE)
  mediaUrl     String
  thumbnailUrl String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  translations HeroSlideTranslation[]

  @@map("hero_slides")
}

model HeroSlideTranslation {
  id       String    @id @default(cuid())
  slide    HeroSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)
  slideId  String
  locale   Locale
  title    String
  subtitle String?
  ctaLabel String?
  ctaUrl   String?

  @@unique([slideId, locale])
  @@map("hero_slide_translations")
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id          String               @id @default(cuid())
  slug        String               @unique
  price       Decimal              @db.Decimal(10, 2)
  childPrice  Decimal?             @db.Decimal(10, 2)
  currency    String               @default("MXN")
  durationMin Int?
  isActive    Boolean              @default(true)
  order       Int                  @default(0)
  coverImage  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  translations PackageTranslation[]
  reservations Reservation[]

  @@map("packages")
}

// ─── Reservations ─────────────────────────────────────────────────────────────

model Reservation {
  id          String            @id @default(cuid())
  folioNumber Int               @unique @default(autoincrement())
  folio       String?           @unique
  packageId   String
  package   Package           @relation(fields: [packageId], references: [id])

  visitDate DateTime
  adults    Int               @default(1)
  children  Int               @default(0)
  infants   Int               @default(0)
  inapamVisitors Int          @default(0)

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  country   String?
  comments  String?

  snapshotName String?
  snapshotLang String?

  subtotalMXN         Decimal  @default(0) @db.Decimal(10, 2)
  inapamDiscountMXN   Decimal  @default(0) @db.Decimal(10, 2)
  couponCode          String?
  couponDiscountMXN   Decimal  @default(0) @db.Decimal(10, 2)
  totalMXN            Decimal  @default(0) @db.Decimal(10, 2)
  extrasMXN           Decimal  @default(0) @db.Decimal(10, 2)
  currency            String   @default("MXN")

  status    ReservationStatus @default(DRAFT)

  payment   Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reservations")
}

model Payment {
  id            String   @id @default(cuid())
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  method        String   // "card" | "oxxo"
  status        String   @default("PENDING")

  stripePaymentIntentId String?
  stripeClientSecret    String?

  oxxoReference  String?
  oxxoVoucherUrl String?
  oxxoExpiresAt  DateTime?

  amountMXN  Decimal  @db.Decimal(10, 2)
  currency   String   @default("MXN")

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payments")
}

enum ReservationStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model PackageTranslation {
  id          String   @id @default(cuid())
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String
  locale      Locale
  name        String
  description String?
  includes    String[]

  @@unique([packageId, locale])
  @@map("package_translations")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
}

enum Locale {
  es
  en
}
